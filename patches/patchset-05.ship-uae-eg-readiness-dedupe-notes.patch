+/**
+ * Dedupe seeded planning rows in Shipments_UAE_EG.
+ * - Key: SKU||normalizeWarehouseCode_(Warehouse (UAE))
+ * - Only rows with blank Shipment ID and seeded tag in Notes are considered.
+ * - Keeps earliest row; clears the rest (safe to re-run).
+ */
+function shipUaeEg_dedupeSeededPlannedRowsV1() {
+  const sh = getSheet_(APP.SHEETS.SHIP_UAE_EG);
+  const map = getHeaderMap_(sh);
+  return _shipUaeEg_dedupeSeededPlannedRowsV1_(sh, map);
+}
+
+function _shipUaeEg_dedupeSeededPlannedRowsV1_(shipSh, shipMap) {
+  const shipIdCol = shipMap[APP.COLS.SHIP_UAE_EG.SHIPMENT_ID];
+  const shipWhCol = shipMap[APP.COLS.SHIP_UAE_EG.WAREHOUSE_UAE];
+  const shipSkuCol = shipMap[APP.COLS.SHIP_UAE_EG.SKU];
+  const shipNotesCol = shipMap['Notes'];
+
+  if (!shipIdCol || !shipWhCol || !shipSkuCol || !shipNotesCol) return { cleared: 0 };
+
+  const lastRow = shipSh.getLastRow();
+  const shipCols = shipSh.getLastColumn();
+  if (lastRow < 2) return { cleared: 0 };
+
+  const data = shipSh.getRange(2, 1, lastRow - 1, shipCols).getValues();
+  const seen = {};
+  const dupRows = [];
+  const tag = 'Seeded from Inventory_UAE';
+
+  for (let i = 0; i < data.length; i++) {
+    const row = data[i];
+    const shipId = String(row[shipIdCol - 1] || '').trim();
+    if (shipId) continue;
+
+    const sku = String(row[shipSkuCol - 1] || '').trim();
+    const wh = normalizeWarehouseCode_(row[shipWhCol - 1]);
+    if (!sku || !wh) continue;
+
+    const note = String(row[shipNotesCol - 1] || '');
+    if (note.indexOf(tag) === -1) continue;
+
+    const key = sku + '||' + wh;
+    if (seen[key] == null) {
+      seen[key] = i + 2; // sheet row number
+    } else {
+      dupRows.push(i + 2);
+    }
+  }
+
+  if (!dupRows.length) return { cleared: 0 };
+
+  dupRows.sort(function (a, b) { return a - b; });
+
+  let cleared = 0;
+  let i = 0;
+  while (i < dupRows.length) {
+    const start = dupRows[i];
+    let end = start;
+    while (i + 1 < dupRows.length && dupRows[i + 1] === end + 1) {
+      i++;
+      end = dupRows[i];
+    }
+    const n = end - start + 1;
+    shipSh.getRange(start, 1, n, shipCols).clearContent();
+    cleared += n;
+    i++;
+  }
+
+  return { cleared: cleared };
+}

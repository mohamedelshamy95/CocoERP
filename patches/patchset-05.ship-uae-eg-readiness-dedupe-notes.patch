+
+/**
+ * Notes helpers: token-safe add/remove (pipe-delimited).
+ */
+function _noteTokens_(note) {
+  return String(note || '')
+    .split('|')
+    .map(function (t) { return String(t || '').trim(); })
+    .filter(function (t) { return !!t; });
+}
+
+function _noteRemoveExactToken_(note, token) {
+  const target = String(token || '').trim();
+  if (!target) return String(note || '');
+  const tokens = _noteTokens_(note).filter(function (t) { return t !== target; });
+  return tokens.join(' | ');
+}
+
+function _noteAddExactToken_(note, token) {
+  const target = String(token || '').trim();
+  if (!target) return String(note || '');
+  const tokens = _noteTokens_(note);
+  if (tokens.indexOf(target) === -1) tokens.push(target);
+  return tokens.join(' | ');
+}
